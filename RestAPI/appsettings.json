{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting": "Information"
    },
    "Console": {
      "IncludeScopes": true,
      "FormatterOptions": {
        "IncludeScopes": true,
        "SingleLine": false,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "AllowedHosts": "*"
}